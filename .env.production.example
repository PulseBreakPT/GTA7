# Documentation only. Production secrets live at /opt/leonida/.env with mode
# 0640, owned by root:gtalore. Never copy development values here.
APP_ENV=production
MONGO_URL=mongodb://gtalore_app:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:27017/leonida_archive?authSource=leonida_archive
DB_NAME=leonida_archive
AUTH_BASE_URL=https://lusorae.pt
AUTH_TRUSTED_ORIGINS=https://lusorae.pt,https://www.lusorae.pt

# Generate each independently with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=

# Optional transactional email. Keep empty to disable email delivery.
RESEND_API_KEY=
AUTH_EMAIL_FROM="GTA LORE <account@lusorae.pt>"
