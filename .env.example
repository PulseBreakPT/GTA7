# Copiar para .env. O .env real não entra no repositório.
MONGO_URL=mongodb://localhost:27017
DB_NAME=leonida_archive
# Origens autorizadas apenas nos endpoints públicos /api/root e /api/status.
CORS_ORIGINS=http://localhost:3000

# Authentication works without an external identity provider. Email
# verification and password recovery delivery become active when these
# optional Resend settings are configured.
AUTH_BASE_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:3000
RESEND_API_KEY=
AUTH_EMAIL_FROM="GTA LORE WIKI <account@example.com>"
