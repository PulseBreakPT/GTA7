# Development only: copy to .env.local. Production uses a separate root-owned
# /opt/leonida/.env file and must never load this file.
APP_ENV=development
MONGO_URL=mongodb://localhost:27017
DB_NAME=leonida_archive

# Generate with: openssl rand -base64 32
# Never reuse the production key. Changing it makes encrypted fields unreadable.
DATA_ENCRYPTION_KEY=

# Authentication works without an external identity provider. Email
# verification and password recovery delivery become active when these
# optional Resend settings are configured.
AUTH_BASE_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:3000
RESEND_API_KEY=
AUTH_EMAIL_FROM="GTA LORE <account@example.com>"
